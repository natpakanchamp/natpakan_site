---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<span class="post-views">
  <svg
    class="icon-eye"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M1.5 12S5.5 4.5 12 4.5 22.5 12 22.5 12 18.5 19.5 12 19.5 1.5 12 1.5 12z"/>
    <circle cx="12" cy="12" r="3.5"/>
  </svg>
  <span id="post-views" class="skeleton skeleton--text" aria-busy="true" data-slug={slug}></span> views
</span>

<script>
  (async function () {
    const el = document.getElementById('post-views');
    if (!el) return;

    function show(text: string) {
      el!.textContent = text;
      el!.classList.remove('skeleton', 'skeleton--text');
      el!.removeAttribute('aria-busy');
    }

    const slug = el.getAttribute('data-slug');
    if (!slug) {
      show('—');
      return;
    }

    try {
      const res = await fetch('/api/track-view', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });

      if (!res.ok) {
        show('—');
        return;
      }

      const { count } = await res.json() as { count: number };
      show(count.toLocaleString());
    } catch (err) {
      show('—');
      console.error('[post-views]', err);
    }
  })();
</script>
