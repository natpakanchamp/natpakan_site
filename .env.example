# Copy to .dev.vars (wrangler / astro dev) and fill in. Never commit real values.
# In production set these in Cloudflare Pages → Settings → Variables and Secrets.

# Existing
GEMINI_API_KEY=

# Secret salt (>= 16 chars) for hashing visitor IPs. Generate: openssl rand -base64 32
IP_HASH_SALT=

# Firestore: full JSON of a Google service account key (one line).
FIREBASE_SERVICE_ACCOUNT=

# --- Admin (/admin) ---
# Cloudflare Access: Zero Trust → Settings → Custom Pages shows the team domain;
# the Access application's Overview tab shows the AUD tag.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Comma-separated, lower-case.
ADMIN_EMAILS=

# Fine-grained PAT: only this repository, permission "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=natpakanchamp/natpakan_site
GITHUB_BRANCH=main

# R2: API token with "Object Read & Write" scoped to the media bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=natpakan-media
# Public URL of the bucket. Production value lives in wrangler.toml [vars]; override here only if needed.
# MEDIA_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# Local only: skip Cloudflare Access while running `astro dev`. Ignored in production builds.
# ADMIN_DEV_BYPASS_EMAIL=you@example.com
